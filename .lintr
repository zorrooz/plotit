# https://lintr.r-lib.org/articles/use.html
linters: linters_with_defaults(
    line_length_linter = line_length_linter(80),
    object_name_linter = object_name_linter(styles = c("snake_case")),
    object_usage_linter = NULL,           # handles S4/S7 slots poorly
    commented_code_linter = NULL,          # allow commented-out code during dev
    cyclocomp_linter = NULL,               # allow complex helper functions
    indentation_linter = indentation_linter(indent = 2L)
  )
encoding: "UTF-8"
exclusions:
  - "playground.R"
  - "R/zzz.R"
  - "tests/testthat.R"
